# Private / local-only material
private-docs/
template/

# Agent workspace (skills and local tool state, not part of the app)
.dsh/

# Scratch directories used while verifying a change
.tmp*/

# Secrets and local environment
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/

# Node / frontend
node_modules/
*.tsbuildinfo

# `frontend/dist/` is deliberately NOT ignored, so the rule above needs an
# exception for it: the built client is committed, and installing the vault then
# needs only `uv`. The launchers and the image both serve the bundle exactly as
# it is checked out, and Bun is required only by someone editing the frontend.
# After changing anything under `frontend/src`, run `bun run build` there and
# commit the result, or the served client will not match the source.
!frontend/dist/
!frontend/dist/**

# Local database
backend/data/
*.db
*.sqlite3

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
